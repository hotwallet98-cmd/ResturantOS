# HTTP + Socket.IO port (API is served under /api, sockets at /socket.io)
PORT=5000

# Prisma connection string. Dev uses a SQLite file relative to Backend/api/.
# PostgreSQL example (see README "Switching to PostgreSQL"):
#   DATABASE_URL="postgresql://user:password@localhost:5432/restaurantos?schema=public"
DATABASE_URL="file:./dev.db"

# Secret used to sign staff JWTs. Change it outside local dev.
JWT_SECRET="change-me-in-production"
# Token lifetime (jsonwebtoken format, e.g. 12h, 7d)
JWT_EXPIRES_IN="12h"

# Soniox API key (server side only). POST /api/voice/soniox-config mints short-lived
# temporary keys from it. Leave empty to get 503 from that endpoint.
SONIOX_API_KEY=
# Optional Soniox data-residency region: us (default) | eu | jp | in
SONIOX_REGION=

# Verification-call telephony: "demo" (default, simulated timeline) or "twilio" (stub, not implemented)
TELEPHONY_PROVIDER=demo
# Demo telephony only: multiply the call timeline (1 = real demo pace, 0.1 = 10x faster)
DEMO_CALL_TIME_SCALE=1
