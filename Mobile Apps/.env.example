# Backend REST base URL (Socket.IO is derived from it by stripping /api).
#   iOS simulator / web:  http://localhost:5000/api
#   Android emulator:     http://10.0.2.2:5000/api
#   Real phone (Expo Go): http://<your PC LAN IP>:5000/api   (e.g. http://192.168.1.20:5000/api)
EXPO_PUBLIC_API_URL=http://localhost:5000/api
# Restaurant whose store the app opens on (GET /public/restaurants/:slug). Defaults to spice-route.
EXPO_PUBLIC_RESTAURANT_SLUG=spice-route
# Optional explicit Socket.IO origin (defaults to EXPO_PUBLIC_API_URL without the /api suffix).
# EXPO_PUBLIC_SOCKET_URL=http://localhost:5000
